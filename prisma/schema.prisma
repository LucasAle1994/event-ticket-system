generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Participant {
  id        Int      @id @default(autoincrement())
  uuid      String   @unique @default(uuid())
  fullName  String
  email     String   @unique
  phone     String
  address   String
  birthDate DateTime
  createdAt DateTime @default(now()) @db.Timestamptz(3)
}
